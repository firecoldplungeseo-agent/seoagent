# ---- Required ----

# Anthropic API — content drafting (Sonnet 4.6)
ANTHROPIC_API_KEY=

# Google PageSpeed Insights API — free 25K req/day
# Get at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# DataForSEO — rank tracking, backlinks, on-page Lighthouse (~$50/mo budget)
# Get at: https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- Required for Mode B (weekly digest) ----

# Gmail SMTP via App Password (Google Workspace requires 2FA + App Password
# generated at https://myaccount.google.com/apppasswords)
GMAIL_USER=hello@firecoldplunge.com
GMAIL_APP_PASSWORD=

# Comma-separated list of digest recipients
DIGEST_RECIPIENTS=John@firecoldplunge.com,scott@firecoldplunge.com,hello@firecoldplunge.com

# ---- Required for Mode C (Shopify drafts) ----

# Shopify Admin API tokens — one per store
# Connected via Claude Desktop MCP — no tokens needed in this file

# ---- Required for Google Search Console integration ----

# OAuth client credentials for GSC API
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# ---- Config ----

# Comma-separated list of domains the agent operates on
SEO_DOMAINS=firecoldplunge.com,plungezero.com,faceplungecompany.com

# (Legacy single-recipient — superseded by DIGEST_RECIPIENTS above; left for backward compat)
DIGEST_EMAIL=hello@firecoldplunge.com
